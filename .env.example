# Copia este archivo a .env y completa la clave en local.
# La clave no se commitea, no viaja al front y no se imprime en los logs.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
LLM_PROVIDER=openrouter

# Solo si LLM_PROVIDER=google
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Render asigna PORT y RENDER_EXTERNAL_URL. En local puedes fijar PUBLIC_URL.
PORT=3000
MAX_ITERACIONES=25
MAX_TOKENS_SESION=80000
MAX_TOKENS_RESPUESTA=2048
LLM_TIMEOUT_MS=90000
